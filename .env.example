# Base URL of the openHealth backend API, including the /api/v1 prefix.
#
# Leave this unset during local development: the Vite dev server proxies
# /api/* to http://localhost:8000 (see vite.config.js).
#
# Set it for production builds, e.g.:
# VITE_API_BASE_URL=https://api.openhealth.example.com/api/v1
VITE_API_BASE_URL=

# Google OAuth 2.0 *Web* client ID, used to draw the "Continue with Google"
# button. Create it in Google Cloud Console -> Credentials, and add the exact
# origin this app is served from under "Authorized JavaScript origins"
# (e.g. http://localhost:5173). No redirect URI is needed.
#
# It must be the SAME client ID as the backend's GOOGLE_CLIENT_ID, or every
# sign-in fails verification. `localhost` and `127.0.0.1` are different origins
# to Google — open the app on the one you registered.
#
# Vite inlines this at BUILD time, so a production build made without it ships
# with no Google button and no error. Leave it unset and the button simply does
# not render, which is the intended behaviour in development.
VITE_GOOGLE_CLIENT_ID=
